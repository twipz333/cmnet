# Keep reports, 3B references, logs, and a small screenshot sample in git.
logs/perf-baseline/capture-ui/
ci-screenshots/*
!ci-screenshots/checks.txt
!ci-screenshots/geometry.json
!ci-screenshots/draft-1920x1080-layout100.png
!ci-screenshots/scout-1920x1080-layout100.png
!ci-screenshots/scout-empty.png
!ci-screenshots/scout-error.png
!ci-screenshots/draft.png
!ci-screenshots/scout.png

local-capture/*
!local-capture/checks.txt
!local-capture/geometry.json
!local-capture/draft-1920x1080-layout100.png
!local-capture/scout-1920x1080-layout100.png
!local-capture/scout-empty.png
!local-capture/scout-error.png

scout-3b-wip/*
!scout-3b-wip/NOTES.md
!scout-3b-wip/REVIEW.md
!scout-3b-wip/checks.txt
!scout-3b-wip/scout.png
!scout-3b-wip/scout-1920x1080-layout100.png
!scout-3b-wip/scout-empty.png
!scout-3b-wip/scout-error.png
!scout-3b-wip/scout-loading.png

draft-3b-wip/*
!draft-3b-wip/NOTES.md
!draft-3b-wip/checks.txt
!draft-3b-wip/draft.png
!draft-3b-wip/draft-1920x1080-layout100.png
!draft-3b-wip/draft-empty.png
!draft-3b-wip/draft-error.png
!draft-3b-wip/draft-loading.png
